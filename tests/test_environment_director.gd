extends SceneTree
const DIRECTOR=preload("res://scripts/environment_director.gd")
func _initialize():
 var director=DIRECTOR.new()
 var env=director.create_environment()
 assert(director.validate_environment(env).ok)
 assert(director.set_time_preset(env,"sunset").ok)
 assert(is_equal_approx(float(env.hour),19.0))
 assert(director.set_hour(env,7.5).ok)
 assert(is_equal_approx(float(env.hour),7.5) and float(env.sun_energy) > 0.5, "Debe interpolar iluminación según la hora")
 assert(director.set_weather(env,"rain",0.7).ok)
 assert(director.get_particle_profile("rain",0.7).enabled)
 assert(is_equal_approx(float(env.wind_strength),0.0) and is_equal_approx(float(env.fog_density),0.0))
 assert(director.set_weather(env,"wind",0.6).ok and is_equal_approx(float(env.wind_strength),0.6))
 assert(director.set_weather(env,"fog",0.4).ok and is_equal_approx(float(env.fog_density),0.4))
 assert(director.set_weather(env,"clear",0.8).ok and is_equal_approx(float(env.weather_intensity),0.0))
 assert(director.set_weather(env,"rain",0.7).ok)
 var added=director.add_background_layer(env,"bg_1",2.0,0.35)
 assert(added.ok)
 var layer_id=str(added.layer.id)
 assert(director.update_background_layer(env,layer_id,{"depth":-2.0,"parallax":0.8,"opacity":0.65,"visible":false}).ok)
 assert(is_equal_approx(float(env.background_layers[0].depth),-2.0))
 assert(is_equal_approx(float(env.background_layers[0].parallax),0.8))
 assert(is_equal_approx(float(env.background_layers[0].opacity),0.65))
 assert(not bool(env.background_layers[0].visible))
 director.set_lighting(env,1.2,0.7,Color(1.0,0.5,0.25),Color(0.2,0.4,0.8))
 assert(is_equal_approx(float(env.sun_energy),1.2))
 assert(is_equal_approx(float(env.ambient_energy),0.7))
 assert(director.add_keyframe(env,0.0,{"sun_energy":0.2,"sky_color":[0.0,0.0,0.0]}).ok)
 assert(director.add_keyframe(env,10.0,{"sun_energy":1.0,"sky_color":[1.0,0.5,0.2]}).ok)
 var sample: Dictionary=director.sample_environment(env,5.0)
 assert(is_equal_approx(float(sample.sun_energy),0.6))
 assert(is_equal_approx(float(sample.sky_color[0]),0.5) and is_equal_approx(float(sample.sky_color[1]),0.25), "Debe interpolar colores ambientales")
 var replaced=director.add_keyframe(env,10.0,{"sun_energy":0.8})
 assert(replaced.ok and replaced.replaced and env.keyframes.size()==2)
 assert(director.remove_keyframe(env,10.0).ok and env.keyframes.size()==1)
 assert(director.remove_background_layer(env,layer_id).ok and env.background_layers.is_empty())
 assert(director.validate_environment(env).ok)
 print("ENVIRONMENT_DIRECTOR_TESTS_OK")
 quit(0)
