extends SceneTree

const TIMELINE = preload("res://scripts/animation_timeline.gd")
const TIMELINE_VIEW = preload("res://scripts/animation_timeline_view.gd")

func _initialize() -> void:
	var timeline = TIMELINE.new()
	assert(timeline.seconds_to_frame(1.0, 24) == 24)
	assert(is_equal_approx(timeline.frame_to_seconds(48, 24), 2.0))
	assert(is_equal_approx(timeline.snap_time_to_frame(0.51, 24), 0.5))
	var track: Dictionary = timeline.create_track("track_x", "Posición X", "object_1", "x")
	assert(not track.is_empty())
	assert(timeline.insert_property_keyframe(track, 0.0, 0.0, "linear").ok)
	assert(timeline.insert_property_keyframe(track, 2.0, 100.0, "linear").ok)
	assert(is_equal_approx(float(timeline.sample_track(track, 1.0)), 50.0))
	var position_track := timeline.create_track("track_position", "Posición XY", "object_1", "position", "vector2")
	assert(timeline.insert_property_keyframe(position_track, 0.0, [0.0, 10.0], "linear").ok)
	assert(timeline.insert_property_keyframe(position_track, 2.0, [100.0, 50.0], "linear").ok)
	var position_sample: Variant = timeline.sample_track(position_track, 1.0)
	assert(position_sample is Array and is_equal_approx(float(position_sample[0]), 50.0) and is_equal_approx(float(position_sample[1]), 30.0), "La trayectoria XY debe interpolar ambos ejes")
	var original_scene := {"id":"scene_preview","objects":[{"id":"object_1","transform":{"x":5.0,"y":10.0,"scale_x":1.0,"scale_y":1.0}}]}
	var preview_scene: Dictionary = timeline.apply_tracks_to_scene(original_scene, [position_track], 1.0)
	assert(is_equal_approx(float(preview_scene.objects[0].transform.x), 50.0) and is_equal_approx(float(preview_scene.objects[0].transform.y), 30.0), "La vista previa debe aplicar la posición animada")
	var camera_position_track := timeline.create_track("camera_position", "Cámara · posición", "__camera__", "position", "vector2")
	timeline.insert_property_keyframe(camera_position_track, 0.0, [960.0, 540.0])
	timeline.insert_property_keyframe(camera_position_track, 2.0, [1000.0, 580.0])
	var camera_zoom_track := timeline.create_track("camera_zoom", "Cámara · zoom", "__camera__", "zoom")
	timeline.insert_property_keyframe(camera_zoom_track, 0.0, 1.0)
	timeline.insert_property_keyframe(camera_zoom_track, 2.0, 2.0)
	var camera_preview: Dictionary = timeline.apply_tracks_to_scene(original_scene, [camera_position_track, camera_zoom_track], 1.0)
	assert(is_equal_approx(float(camera_preview.camera.x), 980.0) and is_equal_approx(float(camera_preview.camera.y), 560.0), "La pista debe animar la posición de cámara")
	assert(is_equal_approx(float(camera_preview.camera.zoom), 1.5), "La pista debe animar el zoom de cámara")
	assert(not original_scene.has("camera"), "La animación de cámara no debe modificar la escena original")
	assert(is_equal_approx(float(original_scene.objects[0].transform.x), 5.0) and is_equal_approx(float(original_scene.objects[0].transform.y), 10.0), "La vista previa no debe modificar el proyecto original")
	var eased := timeline.create_track("track_ease", "Escala", "object_1", "scale_x")
	timeline.insert_property_keyframe(eased, 0.0, 0.0, "ease_in")
	timeline.insert_property_keyframe(eased, 2.0, 100.0, "linear")
	assert(is_equal_approx(float(timeline.sample_track(eased, 1.0)), 25.0))
	var stepped := timeline.create_track("track_step", "Rotación", "object_1", "rotation")
	timeline.insert_property_keyframe(stepped, 0.0, 0.0, "step")
	timeline.insert_property_keyframe(stepped, 1.0, 90.0)
	assert(is_equal_approx(float(timeline.sample_track(stepped, 0.5)), 0.0))
	assert(timeline.validate_track(track).ok)
	assert(not timeline.validate_track({"id":"bad","target_id":"","keyframes":[]}).ok)
	var replaced := timeline.insert_property_keyframe(track, 2.0, 200.0)
	assert(track.keyframes.size() == 2 and is_equal_approx(float(track.keyframes[-1].value),200.0))
	var removed := timeline.remove_property_keyframe(track, 0.0, 0.001)
	assert(removed.ok and track.keyframes.size() == 1)
	assert(is_equal_approx(float(track.keyframes[0].time), 2.0))
	assert(not timeline.remove_property_keyframe(track, 9.0, 0.001).ok)
	var view = TIMELINE_VIEW.new()
	root.add_child(view)
	view.size = Vector2(800, 180)
	var drag_track := timeline.create_track("drag_track", "Posición", "object_1", "x")
	timeline.insert_property_keyframe(drag_track, 1.0, 12.0, "ease_in")
	view.configure([drag_track], 24, 120, 24, 0)
	var moved_events: Array = []
	view.keyframe_moved.connect(func(track_index: int, old_time: float, new_frame: int) -> void:
		moved_events.append({"track": track_index, "old": old_time, "frame": new_frame})
	)
	var press := InputEventMouseButton.new()
	press.button_index = MOUSE_BUTTON_LEFT
	press.pressed = true
	press.position = Vector2(view._frame_x(24), 30.0 + 16.0)
	view._gui_input(press)
	var motion := InputEventMouseMotion.new()
	motion.position = Vector2(view._frame_x(48), 30.0 + 16.0)
	motion.button_mask = MOUSE_BUTTON_MASK_LEFT
	view._gui_input(motion)
	var release := InputEventMouseButton.new()
	release.button_index = MOUSE_BUTTON_LEFT
	release.pressed = false
	release.position = motion.position
	view._gui_input(release)
	assert(moved_events.size() == 1, "Arrastrar un diamante debe emitir un único cambio de keyframe")
	assert(moved_events[0].track == 0 and is_equal_approx(float(moved_events[0].old), 1.0) and moved_events[0].frame == 48, "El arrastre debe conservar pista/origen y calcular el nuevo fotograma")
	view.queue_free()
	print("TIMELINE_TRACK_TESTS_OK")
	quit(0)
