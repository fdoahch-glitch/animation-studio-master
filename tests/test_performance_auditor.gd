extends SceneTree
const AUDITOR=preload("res://scripts/performance_auditor.gd")
func _initialize():
 var auditor=AUDITOR.new()
 var project={"name":"Test","scenes":[{"id":"s1","name":"Escena","objects":[{},{}]}],"resources":[]}
 var report=auditor.audit_project(project)
 assert(report.passed)
 assert(report.summary.object_count==2)
 assert(auditor.estimate_texture_memory(100,100,4,false)==40000)
 assert(is_equal_approx(auditor.recommend_render_scale(30.0,60.0,1.0,0.65),0.95))
 assert(is_equal_approx(auditor.recommend_render_scale(5.0,60.0,0.95,0.65),0.97))
 var constrained=auditor.audit_project(project,{"objects_per_scene":1})
 assert(not constrained.passed and not constrained.warnings.is_empty())
 var malformed=auditor.audit_project({"name":"Malformed","scenes":"not-an-array","resources":"not-an-array"})
 assert(not malformed.passed, "Debe informar colecciones con tipo incorrecto sin bloquearse")
 var malformed_scene=auditor.audit_project({"scenes":[{"name":"Rota","objects":"not-an-array"}],"resources":[{"path":"","bytes":-100}]})
 assert(not malformed_scene.passed, "Debe detectar objetos inválidos y tamaños negativos")
 assert(malformed_scene.summary.resource_bytes==0, "Los tamaños negativos no deben reducir el total")
 assert(is_equal_approx(auditor.recommend_render_scale(5.0,60.0,0.2,0.65),0.65), "La escala nunca debe caer bajo el mínimo configurado")
 print("PERFORMANCE_AUDITOR_TESTS_OK")
 quit(0)
